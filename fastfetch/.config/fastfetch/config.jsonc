{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": {
      "top": 1,
      "left": 2
    }
  },
  "modules": [
    "break",
    "os",
    "kernel",
    "shell",
    "uptime",
    {
      // "Age: [n] days"
      "type": "command",
      "key": "Age",
      "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days"
    },
    // {
    //   // "Birth: [yy-mm-dd] ([n] days ago)"
    //   // (On Debian, this custom module replaces the "disk" module when uncommented. I have no clue why)
    //   "type": "disk",
    //   "key": "Birth",
    //   "folders": "/",
    //   "format": "{create-time:10} ({days} days ago)"
    // },
    "packages",
    "break",
    "de",
    "wm",
    "terminal",
    "terminalfont",
    "break",
    "host",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "display",
    "battery",
    "break",
    "colors",
    "break"
  ]
}